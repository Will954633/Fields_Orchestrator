[Unit]
Description=Fields Off-Market V5 Artifact Poller (valuation report + market update)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=projects
Group=projects
WorkingDirectory=/home/fields/Fields_Orchestrator
EnvironmentFile=/home/fields/Fields_Orchestrator/.env
ExecStart=/home/fields/venv/bin/python3 /home/fields/Fields_Orchestrator/scripts/offmarket_artifact_poller.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
