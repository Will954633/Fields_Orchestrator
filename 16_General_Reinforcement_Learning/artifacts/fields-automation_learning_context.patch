@@ -0,0 +1,250 @@
+"""
+learning_context.py
+===================
+The generator's feedback path. Until now this pipeline wrote articles and never
+found out whether any of them worked: the prompts are static files and the only
+runtime context is property data. This module reads what our own published
+articles actually measured and turns it into a bounded prompt block.
+
+Design notes
+------------
+* Source is a COMMITTED JSON snapshot (`pipeline/data/learning_snapshot.json`),
+  not a live query. This copy ends up on a public website; the evidence steering
+  it has to be reviewable in a diff before it ships, not fetched at run time.
+  Regenerate with `scripts/build_learning_snapshot.py` in Fields_Orchestrator.
+* Degrades to "" if the snapshot is missing or malformed — exactly like
+  `market_context_loader.build_market_context_block`. A missing snapshot must
+  never break generation.
+* Bounded: ~500 words / ~750 tokens. A feedback loop is a small number of
+  load-bearing facts, not 80 documents.
+* The caveats are NOT optional garnish. Everything measured here is CLICKS.
+  Not one lead-optimised ad is in the corpus and the funnel has nine documented
+  high-CTR non-converters, so a block that shipped the patterns without the
+  caveats would be teaching this generator to be interesting rather than useful.
+  `_caveat_block()` is therefore emitted unconditionally and cannot be disabled
+  by a caller.
+
+Usage:
+    from learning_context import build_learning_context_block
+    block = build_learning_context_block()                 # full block
+    block = build_learning_context_block(section="body")   # structure only
+"""
+
+import json
+from pathlib import Path
+
+SNAPSHOT_PATH = Path(__file__).parent / "data" / "learning_snapshot.json"
+
+# How many winners / losers to show. Six rows carry the pattern; fourteen is a
+# data dump the model will average out.
+TOP_N = 4
+BOTTOM_N = 4
+
+
+def _load() -> dict | None:
+    try:
+        if SNAPSHOT_PATH.exists():
+            return json.loads(SNAPSHOT_PATH.read_text(encoding="utf-8"))
+    except Exception:
+        pass
+    return None
+
+
+def _headline_block(snap: dict) -> list[str]:
+    rows = snap.get("headline_outcomes") or []
+    if len(rows) < 3:
+        return []
+    floor = snap.get("impression_floor", 500)
+    top, bottom = rows[:TOP_N], rows[-BOTTOM_N:]
+
+    lines = [
+        "### What our own headlines measured",
+        "",
+        f"Every Fields article headline that has run as a paid ad above {floor} "
+        "impressions. This is our copy, our market, measured — not a style opinion.",
+        "",
+        "| Click-through | Impressions | Headline |",
+        "|---|---|---|",
+    ]
+    for r in top:
+        lines.append(f"| **{r['ctr_pct']}%** | {r['impressions']:,} | {r['title']} |")
+    lines.append("| … | | |")
+    for r in bottom:
+        lines.append(f"| {r['ctr_pct']}% | {r['impressions']:,} | {r['title']} |")
+    # The best-powered failure in the data — quoted so the null is not read as noise.
+    # Derived, never hardcoded: a figure in this block that is not in the snapshot
+    # is a fabrication the model would then repeat.
+    losers = [r for r in rows if r["ctr_pct"] < 1.0]
+    powered = max(losers, key=lambda r: r["impressions"]) if losers else None
+
+    spread = round(top[0]["ctr_pct"] / rows[-1]["ctr_pct"]) if rows[-1]["ctr_pct"] else None
+
+    lines += [
+        "",
+        f"The spread is about {spread}x and the mechanism is legible:" if spread
+        else "The mechanism is legible:",
+        "",
+        "- **One named property, one dominant dollar figure, and a change over time** wins. "
+        "\"Someone paid $X. Eighteen months later…\" is the shape.",
+        "- **A suburb statistic with no person in it loses.** So does a generic question "
+        "(\"Is Now a Good Time to…\") and a how-to guide.",
+    ]
+    if powered:
+        lines.append(
+            f"  The clearest failure ran {powered['impressions']:,} impressions at "
+            f"{powered['ctr_pct']}% — a well-powered null, not noise.")
+    lines += [
+        "- **One number in the headline, not two.** A spread or a three-way framework "
+        "competes with itself.",
+        "- Name the number; never name the category the number is in. "
+        "\"A five-figure gap\" is the abstraction that kills a hook.",
+        "- **A dollar figure is not on its own enough.** There is a specific-address, "
+        "specific-price headline in the losing half of that table. What the winners add is a "
+        "*person and a change over time* — someone bought, someone paid, and then something "
+        "happened. A price with no human event attached reads as a statistic.",
+    ]
+    return lines
+
+
+def _body_block(snap: dict) -> list[str]:
+    rows = snap.get("read_depth") or []
+    if not rows:
+        return []
+    rows = sorted(rows, key=lambda r: -(r.get("paid_sessions") or 0))
+    best = rows[0]
+
+    lines = [
+        "### The body is where we lose them, not the headline",
+        "",
+        f"\"{best['title']}\" earned {best['headline_ctr_pct']}% click-through — near the "
+        f"best in the business — and then {best['paid_sessions']} readers averaged "
+        f"**{best['avg_scroll_pct']}% scroll depth**. Nine in ten were gone before a tenth "
+        "of the page.",
+    ]
+    if len(rows) > 1:
+        o = rows[1]
+        lines.append(
+            f"A second article measured {o['avg_scroll_pct']}% over {o['paid_sessions']} "
+            "sessions. Both readings are small; the direction is not in doubt.")
+    lines += [
+        "",
+        "Scroll depth from social traffic caps around 50% regardless of how good the writing "
+        "is, and only about 10% of arrivals ever reach the foot of the page. So:",
+        "",
+        "- **Everything that must be read goes in the top half.** The single most valuable "
+        "paragraph — the result, the number, the finding — belongs immediately after the "
+        "opening, not in a section six headings down.",
+        "- **Earn the next paragraph, every paragraph.** Description that could apply to any "
+        "home in the suburb is where readers leave. Delete it rather than improve it.",
+        "- **Front-load, don't build.** There is no payoff at the end, because nobody is "
+        "there for it.",
+        "- Do not lengthen an article to hit a word target. Nothing past the halfway mark is "
+        "being read; padding it costs a reader and buys nothing.",
+    ]
+    return lines
+
+
+def _dead_mechanics_block(snap: dict) -> list[str]:
+    mechs = snap.get("dead_hook_mechanics") or []
+    if not mechs:
+        return []
+    lines = [
+        "### Hook mechanics that measured dead",
+        "",
+        "Abstracted from 36 killed advertising angles. **These are verdicts on HOOK "
+        "CONSTRUCTION, not on subject matter** — they were tested as ad copy against a lead "
+        "form, in a different market. A topic on this list is not banned; building a headline "
+        "this way is what failed.",
+        "",
+    ]
+    for m in mechs:
+        lines.append(f"- **{m['mechanic']}** — {m['detail']}")
+    return lines
+
+
+def _caveat_block(snap: dict) -> list[str]:
+    """Emitted unconditionally. See module docstring."""
+    dist = snap.get("distribution") or {}
+    never = dist.get("never_distributed")
+    lines = [
+        "### What this evidence is NOT",
+        "",
+        "**Every number above measures a CLICK.** Not one of the advertisements behind this "
+        "corpus was optimised for enquiries, no lead outcome joins to any of them, and our "
+        "own funnel documented nine high-click-through angles that converted nobody. "
+        "A headline pattern that wins attention is **not** evidence of an article that helps "
+        "anyone.",
+        "",
+        "So the patterns above are permission to be **specific**, never permission to be "
+        "**interesting at the expense of being right**:",
+        "",
+        "- If following one of these patterns would require rounding a price, dropping a "
+        "sample size, omitting that a figure is a rolling 12-month median, implying a "
+        "recommendation, or making a claim the supplied data does not support — **do not "
+        "follow it.** The editorial rules in your system prompt outrank every line of this "
+        "block, without exception. The evidence for these patterns is clicks. The evidence "
+        "for those rules is legal.",
+        "- Never manufacture drama a property does not have. An unremarkable result stated "
+        "plainly is a Fields article; an unremarkable result dressed as a shock is not, and "
+        "the reader who clicks it is the reader who leaves at 10%.",
+        "- The underlying advertising tests ran outside the Gold Coast on a small number of "
+        "outcomes. The *shape* of what works transfers; the magnitudes do not.",
+    ]
+    if never:
+        lines += [
+            f"- Context, not an instruction: **{never} of our articles have never been seen "
+            "by anyone** — zero impressions on any channel. The largest constraint on this "
+            "work is distribution, not writing. Do not over-fit to the handful of articles "
+            "that happen to have been measured.",
+        ]
+    return lines
+
+
+def build_learning_context_block(section: str = "all") -> str:
+    """
+    Build the measured-performance context block for injection into an article prompt.
+
+    Args:
+        section: "all" (default), "headline", or "body". Narrower sections still
+                 carry the caveat block — it is not optional.
+
+    Returns:
+        Markdown string, or "" when the snapshot is unavailable.
+    """
+    snap = _load()
+    if not snap:
+        return ""
+
+    parts: list[str] = [
+        "## WHAT WE HAVE MEASURED ABOUT OUR OWN ARTICLES",
+        "",
+        "Read this before you write. It is the measured outcome of previously published "
+        "Fields articles, and it is here so this pipeline stops repeating what did not work.",
+        "",
+    ]
+
+    blocks: list[list[str]] = []
+    if section in ("all", "headline"):
+        blocks.append(_headline_block(snap))
+    if section in ("all", "body"):
+        blocks.append(_body_block(snap))
+    if section in ("all", "headline"):
+        blocks.append(_dead_mechanics_block(snap))
+    blocks.append(_caveat_block(snap))
+
+    for b in blocks:
+        if b:
+            parts.extend(b)
+            parts.append("")
+
+    built = snap.get("built_at", "")[:10]
+    parts.append(f"_Evidence snapshot: {built}._")
+    parts.append("")
+    return "\n".join(parts)
+
+
+if __name__ == "__main__":
+    block = build_learning_context_block()
+    print(block)
+    print("---")
+    print(f"[{len(block):,} chars, ~{len(block)//4:,} tokens]")
